---
interface Props {
    text?: string;
    hidden?: boolean;
    'data-testid'?: string;
}

const { text, hidden = false, 'data-testid': testId = 'empty-state' } = Astro.props;
---

<div
    data-testid={testId}
    hidden={hidden}
    class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700"
>
    {text ? (
        <p data-testid="empty-state-text" class="text-slate-300">{text}</p>
    ) : (
        <slot />
    )}
</div>
